{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dgenio/contextweaver/benchmarks/onboarding/schema.json",
  "title": "ContextWeaver D1 distribution and retention evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "synthetic",
    "cohort",
    "proposition",
    "acquisition_path",
    "qualified_exposure",
    "understood_proposition",
    "chose_to_evaluate",
    "attempted_setup",
    "first_success",
    "real_source",
    "maintainer_interventions",
    "outcome",
    "dropoff_reason",
    "retention",
    "consent_public"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "participant_id": {"type": ["string", "null"]},
    "synthetic": {"type": "boolean"},
    "cohort": {
      "enum": ["design_partner", "unassisted_evaluator", "persistent_integration"]
    },
    "proposition": {"enum": ["D1", "D2", "D3"]},
    "acquisition_path": {
      "enum": [
        "direct_outreach",
        "github",
        "professional_network",
        "technical_community",
        "content",
        "organic",
        "other"
      ]
    },
    "qualified_exposure": {"type": "boolean"},
    "understood_proposition": {"type": "boolean"},
    "chose_to_evaluate": {"type": "boolean"},
    "attempted_setup": {"type": "boolean"},
    "first_success": {"type": "boolean"},
    "seconds_to_first_success": {"type": ["number", "null"], "minimum": 0},
    "real_source": {"type": "boolean"},
    "maintainer_interventions": {"type": "integer", "minimum": 0},
    "outcome": {
      "enum": [
        "declined",
        "setup_failed",
        "first_success",
        "real_project",
        "retained",
        "removed",
        "pending"
      ]
    },
    "dropoff_reason": {
      "enum": [
        "none",
        "problem_not_relevant",
        "problem_low_severity",
        "existing_alternative_sufficient",
        "proposition_unclear",
        "setup_too_expensive",
        "install_dependency_failure",
        "source_configuration_failure",
        "unsupported_source",
        "semantic_diff_missing_or_misleading",
        "output_unclear",
        "useful_only_as_diagnostic",
        "value_not_consequential",
        "trust_security_process_concern",
        "other",
        "unknown"
      ]
    },
    "retained_slice": {
      "enum": [
        "none",
        "snapshot_and_diff",
        "diff_only",
        "inspect_only",
        "single_source_only",
        "other"
      ]
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day7", "day30"],
      "properties": {
        "day7": {
          "enum": ["active_independent", "active_assisted", "removed", "no_followup", "not_due"]
        },
        "day30": {
          "enum": ["active_independent", "active_assisted", "removed", "no_followup", "not_due"]
        },
        "removed_reason": {"type": ["string", "null"]}
      }
    },
    "contextweaver_version": {"type": ["string", "null"]},
    "commit_sha": {"type": ["string", "null"]},
    "source_type": {"enum": ["none", "openapi", "mcp", "native", "other"]},
    "notes": {"type": "string"},
    "consent_public": {"type": "boolean"}
  }
}
